#!name=po0 防火墙自动加白
#!desc=调用 po0 防火墙 API 将本机当前出口 IP 加入白名单。支持多 token（英文逗号分割，对应多台机器），network-changed 事件与每 10 分钟 cron 自动触发。
#!category=po0
#!author=reallinzc
#!arguments=tokens:""
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号 , 分割；可选在 token 后加 @槽位（如 pgnfw_xxx@0）钉固定坑位、永不被淘汰

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=60,script-update-interval=3600,argument="tokens={{{tokens}}}"
