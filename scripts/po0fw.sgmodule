#!name=po0 防火墙自动加白
#!desc=po0 自动加白 + 指定 Surge 代理 HEAD 连通性检测；失败重试。新增可调详细日志：逐轮 API/HEAD、异常、重试、历史。
#!category=po0
#!author=reallinzc
#!arguments=tokens:"",test_proxy:"",retry_count:3,test_url:"http://cp.cloudflare.com/generate_204",log_level:"detail"
#!arguments-desc=tokens: po0 API token（多个用英文逗号分隔，支持 @槽位）；test_proxy: 完整节点名称，留空仅加白；retry_count: 连通性失败后额外加白 0-5 次；test_url: HEAD 检测 URL（默认 204）；log_level: detail=每步详细记录（默认），summary=仅小结与错误，off=不输出控制台日志。

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}&log_level={{{log_level}}}&trigger=cron"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}&log_level={{{log_level}}}&trigger=network-changed"
po0-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}&log_level={{{log_level}}}&trigger=engine-started"
