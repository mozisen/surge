#!name=po0 防火墙自动加白
#!desc=po0 API 自动加白；可选指定 Surge 代理节点发送 HTTP HEAD 连通性测试，失败自动重试加白，无需外部探针。
#!category=po0
#!author=reallinzc
#!arguments=tokens:"",test_proxy:"",retry_count:3,test_url:"http://cp.cloudflare.com/generate_204"
#!arguments-desc=tokens: po0 API token，可多个逗号分隔、支持 @槽位；test_proxy: 与 Surge [Proxy] 内的节点名称完全一致（留空不检测）；retry_count: 测试失败后额外加白次数 0-5，默认 3；test_url: HTTP(S) HEAD 测试地址，默认 Cloudflare generate_204，预期 HTTP 204。

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}"
po0-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/mozisen/surge/refs/heads/main/scripts/Po0fw.js,timeout=90,script-update-interval=3600,argument="tokens={{{tokens}}}&test_proxy={{{test_proxy}}}&retry_count={{{retry_count}}}&test_url={{{test_url}}}"
