#!name=WiFi 自动控制 po0加白 · Po0槽位面板
#!desc=连接指定 WiFi 时自动关闭「po0 防火墙自动加白」，离开后自动开启；同时提供只读 Po0槽位面板，查看固定槽位、FIFO 记录和剩余容量，以实心圆及 IP 后的「← 当前出口」标记当前出口，并通过 slot_names 统一自定义槽位名称。
#!system=ios
#!category=po0
#!author=mozisen

#!arguments=wifi_list:wifi1|wifi2,TOKEN:pgnfw_REPLACE_ME,slot_names:固定槽 0|固定槽 1;FIFO 1|FIFO 2|FIFO 3
#!arguments-desc=wifi_list：填写需要关闭「po0 防火墙自动加白」的 WiFi 名称，多个使用 | 分隔，例如 mozi|weeland|mozi-5G；TOKEN：填写单个 po0fw token，可省略 @0 等槽位后缀；slot_names：统一填写固定槽和 FIFO 名称，英文分号 ; 前是固定槽名称（从槽 0 开始按编号），后是 FIFO 名称（按显示顺序），各组使用 | 分隔，例如 家里|公司;临时 1|临时 2|临时 3；FIFO 名称随显示位置而非 IP，留空或未填写的槽位使用默认名称。请勿公开分享填写了真实 token 的模块。

[Panel]
po0fw-slots = title="Po0槽位面板", content="点击刷新查询", style=info, script-name=po0fw-slots, update-interval=60

[Script]
WiFi-模块切换 = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/mozisen/surge/main/scripts/wifi-module-switch.js,script-update-interval=3600,argument="{{{wifi_list}}}"

WiFi-启动检查 = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/mozisen/surge/main/scripts/wifi-module-switch.js,script-update-interval=3600,argument="{{{wifi_list}}}"

po0fw-slots = type=generic,script-path=https://raw.githubusercontent.com/mozisen/surge/main/scripts/po0fw-panel.js,script-update-interval=3600,timeout=15,argument="token={{{TOKEN}}}&slot_names={{{slot_names}}}"
